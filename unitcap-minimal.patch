diff --git a/src/game/battlectl.cpp b/src/game/battlectl.cpp
new file mode 100644
index 0000000..900136e
--- /dev/null
+++ b/src/game/battlectl.cpp
@@ -0,0 +1,241 @@
+#include "battlectl.h"
+
+#include <windows.h>
+
+#include <string>
+
+#include "luaops.h"
+
+namespace {
+
+using namespace luaops;
+
+// 逐帧生效的开关全部塞进 _G.__sbBattleCfg，包装函数每次现查；关掉透传。
+// 回：状态  1
+constexpr const char* kSyncLua = R"lua(
+local c = rawget(_G, '__sbBattleCfg')
+if type(c) ~= 'table' then c = {}; rawset(_G, '__sbBattleCfg', c) end
+c.speed = SPEED
+c.expMul = EXPMUL
+c.infLives = INFLIVES
+c.infHp = INFHP
+c.defense = DEFENSE
+c.damage = DAMAGE
+c.oneHit = ONEHIT
+
+-- 经验倍率：游戏成长实际是 absorbLV，包装它的成长倍率表
+local K = package.loaded['src.data.constants']
+if type(K) == 'table' and type(K.evolution) == 'table' and type(K.evolution.getAbsorbLvMultipliers) == 'function' then
+  local E = K.evolution
+  local H = rawget(_G, '__sbExpHook')
+  local cur = E.getAbsorbLvMultipliers
+  if type(H) ~= 'table' or H.wrapper ~= cur then
+    local orig = cur
+    H = { orig = orig }
+    H.wrapper = function(...)
+      local r = orig(...)
+      local cfg = rawget(_G, '__sbBattleCfg')
+      local m = cfg and tonumber(cfg.expMul) or 1
+      if type(r) == 'table' and m and m ~= 1 then
+        local v = {}
+        for k, val in pairs(r) do
+          if type(val) == 'number' and val > 1 then v[k] = 1 + (val - 1) * m else v[k] = val end
+        end
+        return v
+      end
+      return r
+    end
+    E.getAbsorbLvMultipliers = H.wrapper
+    rawset(_G, '__sbExpHook', H)
+  end
+end
+
+-- 逐帧生效：包 battlefield.update。换局重建实例时靠 BF ~= self 重新装。
+local bf = rawget(_G, 'battlefield')
+if type(bf) ~= 'table' or type(bf.update) ~= 'function' then return 'nobf\t0' end
+local BH = rawget(_G, '__sbBattleUpdateHook')
+if type(BH) ~= 'table' or BH.bf ~= bf or BH.wrapper ~= bf.update then
+  local orig = bf.update
+  BH = { orig = orig, bf = bf }
+  local function apply(self)
+    local cfg = rawget(_G, '__sbBattleCfg') or {}
+    if cfg.infLives then
+      self.baseDamageBuffer = 0
+      if (tonumber(self.baseHP) or 0) < 9999 then self.baseHP = 9999 end
+      self.suddenDeathWave = false
+      self.gameOver = false
+    end
+    for _, a in ipairs(self.allies or {}) do
+      if type(a) == 'table' then
+        if cfg.infHp then
+          a.hp = a.maxhp or a.hp
+          a.invuln = true
+          a._invulnT = 1e9
+        end
+        local dr = tonumber(cfg.defense) or 0
+        if dr > 0 and (tonumber(a.selfDR) or 0) < dr then a.selfDR = dr end
+        local mul = tonumber(cfg.damage) or 1
+        if mul ~= 1 then
+          local base = a.__sbBaseDmg
+          if type(base) ~= 'number' then base = tonumber(a.dmg) or 0; a.__sbBaseDmg = base end
+          a.dmg = base * mul
+        elseif type(a.__sbBaseDmg) == 'number' then
+          a.dmg = a.__sbBaseDmg
+          a.__sbBaseDmg = nil
+        end
+      end
+    end
+    if cfg.oneHit then
+      for _, e in ipairs(self.enemies or {}) do
+        if type(e) == 'table' then e.hp = 1 end
+      end
+    end
+  end
+  BH.wrapper = function(self, dt, ...)
+    local cfg = rawget(_G, '__sbBattleCfg') or {}
+    local speed = tonumber(cfg.speed) or 1
+    if speed ~= 1 then dt = dt * speed end
+    apply(self)
+    local r = orig(self, dt, ...)
+    apply(self) -- 游戏里有些技能会重置 invuln，orig 之后再补一次
+    return r
+  end
+  bf.update = BH.wrapper
+  rawset(_G, '__sbBattleUpdateHook', BH)
+end
+return 'ok\t1'
+)lua";
+
+constexpr const char* kAddUnitsLua = R"lua(
+local bf = rawget(_G, 'battlefield')
+if type(bf) ~= 'table' or type(bf.spawn) ~= 'function' then return 'nobf' end
+local ok, err = pcall(bf.spawn, bf, SYMBOL, COUNT)
+if not ok then return 'err:' .. tostring(err) end
+return 'ok'
+)lua";
+
+constexpr const char* kRerollShopLua = R"lua(
+local ui = rawget(_G, 'ui')
+if type(ui) ~= 'table' then return 'noui' end
+local I = package.loaded['src.game.item'] or require('src.game.item')
+if type(I) ~= 'table' or type(I.offer) ~= 'function' then return 'noitem' end
+local bf = rawget(_G, 'battlefield')
+local wave = bf and type(bf.wave) == 'table' and tonumber(bf.wave.id) or 1
+local ok, offers = pcall(I.offer, 3, wave, ui._itemPurchased or {})
+if not ok or type(offers) ~= 'table' then return 'nooffers' end
+ui._itemOffers = offers
+ui._itemShopPurchased = {}
+return 'ok'
+)lua";
+
+constexpr const char* kAddLifeLua = R"lua(
+local bf = rawget(_G, 'battlefield')
+if type(bf) ~= 'table' then return 'nobf' end
+bf.baseHP = math.max(0, (tonumber(bf.baseHP) or 0) + N)
+return 'ok'
+)lua";
+
+} // namespace
+
+void BattleControl::OnAction(const bridge::Result& r)
+{
+    if (!r.ok) {
+        error_ = "失败：" + r.text;
+        message_.clear();
+        return;
+    }
+    error_.clear();
+    if (r.text == "ok") {
+        if (pendingAction_ == "add")
+            message_ = "已把单位加入军团（下一帧生效）";
+        else if (pendingAction_ == "reroll")
+            message_ = "商店物品已刷新";
+        else
+            message_ = "生命点数已增加";
+    } else if (r.text == "nobf")
+        error_ = "失败：还没进到一局游戏里";
+    else if (r.text == "noui")
+        error_ = "失败：还没连上游戏界面";
+    else if (r.text == "noitem")
+        error_ = "失败：找不到商店模块";
+    else if (r.text == "nooffers")
+        error_ = "失败：游戏没生成商店物品";
+    else
+        error_ = "失败：" + r.text;
+}
+
+void BattleControl::Update(bool injected, bool speedOn, int speedPct, bool expOn, int expPct,
+                           bool infLives, bool infHp, int defensePct, bool damageOn, int damagePct,
+                           bool oneHit)
+{
+    if (Ready(syncJob_)) {
+        const bridge::Result r = syncJob_.get();
+        if (!r.ok) {
+            error_ = r.text;
+            hooked_ = false;
+        } else {
+            const auto f = Split(r.text, '\t');
+            hooked_ = f[0] == "ok";
+            if (!hooked_)
+                error_ = "还没进到一局游戏（找不到 battlefield）";
+            else
+                error_.clear();
+        }
+    }
+    if (Ready(actionJob_))
+        OnAction(actionJob_.get());
+
+    if (!injected) {
+        hooked_ = false;
+        return;
+    }
+    const bool changed = speedOn != sentSpeedOn_ || speedPct != sentSpeedPct_ || expOn != sentExpOn_ ||
+        expPct != sentExpPct_ || infLives != sentInfLives_ || infHp != sentInfHp_ ||
+        defensePct != sentDefensePct_ || damageOn != sentDamageOn_ || damagePct != sentDamagePct_ ||
+        oneHit != sentOneHit_;
+    const ULONGLONG now = GetTickCount64();
+    if (syncJob_.valid() || (!changed && now - lastSync_ < 500))
+        return;
+    lastSync_ = now;
+    sentSpeedOn_ = speedOn; sentSpeedPct_ = speedPct;
+    sentExpOn_ = expOn; sentExpPct_ = expPct;
+    sentInfLives_ = infLives; sentInfHp_ = infHp;
+    sentDefensePct_ = defensePct;
+    sentDamageOn_ = damageOn; sentDamagePct_ = damagePct;
+    sentOneHit_ = oneHit;
+
+    const std::string prefix =
+        "local SPEED = " + Number(speedOn ? speedPct / 100.0 : 1.0) +
+        "\nlocal EXPMUL = " + Number(expOn ? expPct / 100.0 : 1.0) +
+        "\nlocal INFLIVES = " + (infLives ? "true" : "false") +
+        "\nlocal INFHP = " + (infHp ? "true" : "false") +
+        "\nlocal DEFENSE = " + Number(defensePct / 100.0) +
+        "\nlocal DAMAGE = " + Number(damageOn ? damagePct / 100.0 : 1.0) +
+        "\nlocal ONEHIT = " + (oneHit ? "true" : "false") + "\n";
+    syncJob_ = Run(prefix + kSyncLua);
+}
+
+void BattleControl::AddUnits(const std::string& symbol, int count)
+{
+    if (actionJob_.valid())
+        return;
+    pendingAction_ = "add";
+    const std::string prefix = "local SYMBOL, COUNT = " + Quote(symbol) + ", " + Number(count) + "\n";
+    actionJob_ = Run(prefix + kAddUnitsLua);
+}
+
+void BattleControl::RerollShop()
+{
+    if (actionJob_.valid())
+        return;
+    pendingAction_ = "reroll";
+    actionJob_ = Run(kRerollShopLua);
+}
+
+void BattleControl::AddLifePoints(int n)
+{
+    if (actionJob_.valid())
+        return;
+    pendingAction_ = "life";
+    actionJob_ = Run(std::string("local N = ") + Number(n) + "\n" + kAddLifeLua);
+}
diff --git a/src/game/battlectl.h b/src/game/battlectl.h
new file mode 100644
index 0000000..28b25c5
--- /dev/null
+++ b/src/game/battlectl.h
@@ -0,0 +1,41 @@
+#pragma once
+
+#include <future>
+#include <string>
+
+#include "bridge/luaclient.h"
+
+// 战斗控制：经 Lua 桥包装 battlefield.update 与常量模块，一次装好所有逐帧生效的开关。
+// 包装里只读 _G.__sbBattleCfg，关掉就透传；换局重建 battlefield 时每秒自检会重新挂。
+// 加人 / 刷新商店 / 加生命点是一次性动作，不走逐帧包装。
+class BattleControl {
+public:
+    void Update(bool injected, bool speedOn, int speedPct, bool expOn, int expPct,
+                bool infLives, bool infHp, int defensePct, bool damageOn, int damagePct,
+                bool oneHit);
+
+    void AddUnits(const std::string& symbol, int count); // 职业符号 W/A/S/M/H/D + 数量
+    void RerollShop();
+    void AddLifePoints(int n);
+
+    bool Busy() const { return actionJob_.valid(); }
+    bool Hooked() const { return hooked_; }
+    const std::string& Error() const { return error_; }
+    const std::string& Message() const { return message_; }
+
+private:
+    void OnAction(const bridge::Result& r);
+
+    std::future<bridge::Result> syncJob_;
+    std::future<bridge::Result> actionJob_;
+    std::string pendingAction_;
+
+    unsigned long long lastSync_ = 0;
+    bool sentSpeedOn_ = false, sentExpOn_ = false, sentInfLives_ = false, sentInfHp_ = false;
+    bool sentDamageOn_ = false, sentOneHit_ = false;
+    int sentSpeedPct_ = 100, sentExpPct_ = 100, sentDefensePct_ = 0, sentDamagePct_ = 100;
+
+    bool hooked_ = false;
+    std::string error_;
+    std::string message_;
+};
diff --git a/src/game/corectl.cpp b/src/game/corectl.cpp
new file mode 100644
index 0000000..8d5900b
--- /dev/null
+++ b/src/game/corectl.cpp
@@ -0,0 +1,217 @@
+#include "corectl.h"
+
+#include <windows.h>
+
+#include <cstdlib>
+
+#include "luaops.h"
+
+namespace {
+
+using namespace luaops;
+
+// 核心目录：id<TAB>中文名<TAB>稀有度<TAB>key，一行一个
+constexpr const char* kCatalogLua = R"lua(
+local C = package.loaded['src.game.cores'] or require('src.game.cores')
+if type(C) ~= 'table' or type(C.getIds) ~= 'function' or type(C.getById) ~= 'function' then return '' end
+local L = package.loaded['src.data.language'] or require('src.data.language')
+local out = {}
+for _, id in ipairs(C.getIds()) do
+  local d = C.getById(id)
+  if type(d) == 'table' then
+    local zh = tostring(d.name or '')
+    if type(L) == 'table' and type(L.getCoreName) == 'function' then
+      local ok, n = pcall(L.getCoreName, d.key, d.name, 'zh')
+      if ok and n and n ~= '' then zh = tostring(n) end
+    end
+    out[#out+1] = tostring(id) .. '\t' .. zh .. '\t' .. tostring(d.rarity or '') .. '\t' .. tostring(d.key or '')
+  end
+end
+return table.concat(out, '\n')
+)lua";
+
+// 核心必出：包装 cores.offer（初次打开和 reroll 都走它），关掉时原样透传。
+// 回：状态  已塞入次数  核心选择页是否开着
+constexpr const char* kSyncLua = R"lua(
+local cfg = rawget(_G, '__sbCoreCfg')
+if type(cfg) ~= 'table' then cfg = {}; rawset(_G, '__sbCoreCfg', cfg) end
+cfg.forceId = FORCE_ID
+local C = package.loaded['src.game.cores'] or require('src.game.cores')
+if type(C) ~= 'table' or type(C.offer) ~= 'function' then return 'nocores\t0\t0' end
+local W = rawget(_G, '__sbCoreWrapped')
+if type(W) ~= 'table' then W = setmetatable({}, { __mode = 'k' }); rawset(_G, '__sbCoreWrapped', W) end
+if not W[C.offer] then
+  local orig = C.offer
+  local function w(...)
+    local r = orig(...) or {}
+    local want = cfg.forceId
+    if type(r) == 'table' and want and want ~= '' and type(C.getById) == 'function' then
+      local def = C.getById(want)
+      if type(def) == 'table' then
+        r[1] = def
+        for i = 2, 3 do
+          if type(r[i]) == 'table' and r[i].id == def.id then r[i] = nil end
+        end
+        cfg.hits = (cfg.hits or 0) + 1
+      end
+    end
+    return r
+  end
+  W[w] = true
+  C.offer = w
+  rawset(_G, '__sbCoreOrigOffer', orig)
+end
+local ui = rawget(_G, 'ui')
+local open = type(ui) == 'table' and type(ui._coreSelect) == 'table' and ui._coreSelect.active or false
+return 'ok\t' .. tostring(cfg.hits or 0) .. '\t' .. (open and '1' or '0')
+)lua";
+
+// 强制打开核心选择页。必须带 fromCountdown=true，否则 render.lua 会立刻把弹窗清掉。
+constexpr const char* kOpenLua = R"lua(
+local ui = rawget(_G, 'ui')
+if type(ui) ~= 'table' then return 'no-ui' end
+if type(ui._coreSelect) == 'table' and ui._coreSelect.active then return 'already' end
+local C = package.loaded['src.game.cores'] or require('src.game.cores')
+if type(C) ~= 'table' or type(C.offer) ~= 'function' then return 'no-cores' end
+local order = (tonumber(rawget(_G, 'coreSelectionsMade')) or 0) + 1
+local ok, o = pcall(C.offer, 3, order, nil)
+if not ok or type(o) ~= 'table' then return 'no-offers' end
+local list = { o[1], o[2], o[3] }
+if not (list[1] or list[2] or list[3]) then return 'no-offers' end
+rawset(_G, '__sbCoreForceBackup', {
+  cs = ui._coreSelect, cache = ui._coreSelectOffersCache, deferred = ui._deferredCoreSelect
+})
+ui._coreSelect = {
+  active = true,
+  startT = (type(love) == 'table' and type(love.timer) == 'table' and type(love.timer.getTime) == 'function') and love.timer.getTime() or 0,
+  offers = list,
+  fromCountdown = true,
+  rerollCost = 0,
+  _paidRerollCost = ui._coreSelectRerollCost or 1,
+  _usesUpgradeFreeReroll = false,
+}
+return 'ok'
+)lua";
+
+// 关掉刚才强制打开的页面，还原原来的状态（包括用户原本可能开着的详情窗）
+constexpr const char* kCloseLua = R"lua(
+local ui = rawget(_G, 'ui')
+if type(ui) ~= 'table' then return 'no-ui' end
+local b = rawget(_G, '__sbCoreForceBackup')
+ui._coreSelect = b and b.cs or nil
+ui._coreSelectOffersCache = b and b.cache or nil
+ui._deferredCoreSelect = b and b.deferred or nil
+ui._coreSelectReturnHover = nil
+ui._coreJokerTooltipState = nil
+rawset(_G, '__sbCoreForceBackup', nil)
+return 'ok'
+)lua";
+
+} // namespace
+
+const CoreDef* CoreControl::Find(const std::string& id) const
+{
+    for (const CoreDef& d : catalog_)
+        if (d.id == id)
+            return &d;
+    return nullptr;
+}
+
+void CoreControl::OnAction(const bridge::Result& r)
+{
+    if (!r.ok) {
+        error_ = "失败：" + r.text;
+        message_.clear();
+        return;
+    }
+    error_.clear();
+    if (r.text == "ok")
+        message_ = pendingAction_ == "close" ? "已关闭核心选择页" : "已打开核心选择页";
+    else if (r.text == "already")
+        message_ = "核心选择页已经开着";
+    else if (r.text == "no-ui")
+        error_ = "失败：还没连上游戏界面";
+    else if (r.text == "no-cores")
+        error_ = "失败：找不到核心模块（版本不对？）";
+    else if (r.text == "no-offers")
+        error_ = "失败：游戏没生成核心候选";
+    else
+        message_ = r.text;
+}
+
+void CoreControl::Update(bool injected, bool enabled, const std::string& forceId)
+{
+    if (Ready(catalogJob_)) {
+        const bridge::Result r = catalogJob_.get();
+        if (r.ok && !r.text.empty()) {
+            catalog_.clear();
+            for (const std::string& line : Split(r.text, '\n')) {
+                const auto f = Split(line, '\t');
+                if (f.empty() || f[0].empty())
+                    continue;
+                CoreDef d;
+                d.id = f[0];
+                d.name = f.size() > 1 ? f[1] : f[0];
+                d.rarity = f.size() > 2 ? f[2] : std::string();
+                d.key = f.size() > 3 ? f[3] : std::string();
+                catalog_.push_back(std::move(d));
+            }
+            catalogLoaded_ = !catalog_.empty();
+        }
+    }
+    if (Ready(syncJob_)) {
+        const bridge::Result r = syncJob_.get();
+        if (!r.ok) {
+            error_ = r.text;
+            hooked_ = false;
+        } else {
+            const auto f = Split(r.text, '\t');
+            hooked_ = f[0] == "ok";
+            hits_ = f.size() > 1 ? atoi(f[1].c_str()) : 0;
+            pageOpen_ = f.size() > 2 && f[2] == "1";
+            if (!hooked_)
+                error_ = "没找到 src.game.cores.offer（版本不对？）";
+            else
+                error_.clear();
+        }
+    }
+    if (Ready(actionJob_))
+        OnAction(actionJob_.get());
+
+    if (!injected) {
+        hooked_ = false;
+        pageOpen_ = false;
+        return;
+    }
+    const ULONGLONG now = GetTickCount64();
+    if (!catalogLoaded_ && !catalogJob_.valid() && now - lastCatalogTry_ >= 2000) {
+        lastCatalogTry_ = now;
+        catalogJob_ = Run(kCatalogLua);
+    }
+    const bool changed = enabled != sentEnabled_ || forceId != sentForceId_;
+    if (syncJob_.valid() || (!changed && now - lastSync_ < 1000))
+        return;
+    lastSync_ = now;
+    sentEnabled_ = enabled;
+    sentForceId_ = forceId;
+    const std::string prefix = "local FORCE_ID = " + (forceId.empty() ? "nil" : Quote(forceId)) + "\n";
+    syncJob_ = Run(prefix + kSyncLua);
+}
+
+void CoreControl::OpenPage()
+{
+    if (actionJob_.valid())
+        return;
+    message_.clear();
+    pendingAction_ = "open";
+    actionJob_ = Run(kOpenLua);
+}
+
+void CoreControl::ClosePage()
+{
+    if (actionJob_.valid())
+        return;
+    message_.clear();
+    pendingAction_ = "close";
+    actionJob_ = Run(kCloseLua);
+}
diff --git a/src/game/corectl.h b/src/game/corectl.h
new file mode 100644
index 0000000..ea43050
--- /dev/null
+++ b/src/game/corectl.h
@@ -0,0 +1,60 @@
+#pragma once
+
+#include <future>
+#include <string>
+#include <vector>
+
+#include "bridge/luaclient.h"
+
+// 核心目录里的一项：id 是 getById 认的字符串编号，name 是中文名
+struct CoreDef {
+    std::string id;
+    std::string name;
+    std::string rarity;
+    std::string key;
+};
+
+// 核心控制：经 Lua 桥做两件事
+//   1) 强制核心选择页：直接构造 _G.ui._coreSelect，让游戏弹核心选择窗（一次性动作，不是常驻 hook）
+//   2) 核心必出：包住 package.loaded['src.game.cores'].offer，把指定核心放到第 1 个候选；
+//      关掉时包装原样透传，游戏自己重新 require 时每秒自检会重新包上
+class CoreControl {
+public:
+    // 每帧调用。injected = Lua 桥可用；enabled / forceId 是当前「核心必出」设置
+    void Update(bool injected, bool enabled, const std::string& forceId);
+
+    void OpenPage();  // 强制打开核心选择页（一次性）
+    void ClosePage(); // 关掉刚才强制打开的页面并还原原状态
+
+    bool CatalogLoaded() const { return catalogLoaded_; }
+    const std::vector<CoreDef>& Catalog() const { return catalog_; }
+    const CoreDef* Find(const std::string& id) const;
+
+    bool Busy() const { return actionJob_.valid(); }
+    bool Hooked() const { return hooked_; }
+    int Hits() const { return hits_; }        // 本次游戏里「指定核心」被塞进候选的次数
+    bool PageOpen() const { return pageOpen_; }
+    const std::string& Error() const { return error_; }
+    const std::string& Message() const { return message_; }
+
+private:
+    void OnAction(const bridge::Result& r);
+
+    std::future<bridge::Result> catalogJob_;
+    std::future<bridge::Result> syncJob_;
+    std::future<bridge::Result> actionJob_;
+
+    unsigned long long lastCatalogTry_ = 0;
+    unsigned long long lastSync_ = 0;
+    bool sentEnabled_ = false;
+    std::string sentForceId_;
+
+    bool catalogLoaded_ = false;
+    bool hooked_ = false;
+    bool pageOpen_ = false;
+    int hits_ = 0;
+    std::vector<CoreDef> catalog_;
+    std::string error_;
+    std::string message_;
+    std::string pendingAction_; // "open" / "close"，用来把回执翻成中文
+};
diff --git a/src/game/unitcap.cpp b/src/game/unitcap.cpp
new file mode 100644
index 0000000..824df13
--- /dev/null
+++ b/src/game/unitcap.cpp
@@ -0,0 +1,94 @@
+#include "unitcap.h"
+
+#include <windows.h>
+
+#include <cstdlib>
+
+#include "luaops.h"
+
+namespace {
+
+using namespace luaops;
+
+// 装包装（已装就跳过）+ 写设置，回：状态  生效上限  当前人数  原版上限
+// 游戏里的公式是 5 + require('src.ui.upgrade').getMaxUnitBonus()；包装只改这个返回值。
+// 用 rawget/rawset 碰 _G，跟游戏和修改器其它 hook 的写法保持一致。
+constexpr const char* kSyncLua = R"lua(
+local function getModule()
+  for _, name in ipairs({ 'src.ui.upgrade', 'src.game.upgrade' }) do
+    local m = package.loaded[name]
+    if type(m) == 'table' and type(m.getMaxUnitBonus) == 'function' then return m end
+  end
+  local ok, m = pcall(require, 'src.ui.upgrade')
+  if ok and type(m) == 'table' and type(m.getMaxUnitBonus) == 'function' then return m end
+  return nil
+end
+local U = getModule()
+if not U then return 'no_module\t0\t-1\t0' end
+local H = rawget(_G, '__sbUnitCapHook')
+local cur = U.getMaxUnitBonus
+if type(H) ~= 'table' or H.wrapper ~= cur or H.module ~= U then
+  local orig = cur
+  H = { orig = orig, module = U }
+  H.wrapper = function(...)
+    local c = rawget(_G, '__sbUnitCapCfg')
+    if c and c.enabled then
+      local n = tonumber(c.cap)
+      if n and n >= 5 then return math.max(0, math.floor(n) - 5) end
+    end
+    return orig(...)
+  end
+  U.getMaxUnitBonus = H.wrapper
+  rawset(_G, '__sbUnitCapHook', H)
+end
+local c = rawget(_G, '__sbUnitCapCfg')
+if type(c) ~= 'table' then c = {}; rawset(_G, '__sbUnitCapCfg', c) end
+c.enabled = ENABLED
+c.cap = CAP
+local bf = rawget(_G, 'battlefield')
+local count = -1
+if type(bf) == 'table' and type(bf.getOwnedUnitCount) == 'function' then
+  local ok2, n = pcall(bf.getOwnedUnitCount, bf)
+  if ok2 then count = math.max(0, math.floor(tonumber(n) or 0)) end
+end
+local ok3, bonus = pcall(H.orig)
+if not ok3 then bonus = 0 end
+local origCap = 5 + math.max(0, math.floor(tonumber(bonus) or 0))
+local eff = c.enabled and math.max(5, math.floor(tonumber(c.cap) or 5)) or origCap
+return 'ok\t' .. tostring(eff) .. '\t' .. tostring(count) .. '\t' .. tostring(origCap)
+)lua";
+
+} // namespace
+
+void UnitCapControl::Update(bool injected, bool enabled, int cap)
+{
+    if (Ready(job_)) {
+        const bridge::Result r = job_.get();
+        if (!r.ok) {
+            error_ = r.text;
+            hooked_ = false;
+        } else {
+            const auto f = Split(r.text, '\t');
+            hooked_ = f[0] == "ok";
+            effectiveCap_ = f.size() > 1 ? atoi(f[1].c_str()) : 0;
+            unitCount_ = f.size() > 2 ? atoi(f[2].c_str()) : -1;
+            originalCap_ = f.size() > 3 ? atoi(f[3].c_str()) : 0;
+            error_ = hooked_ ? std::string() : "没找到游戏的 getMaxUnitBonus（版本不对？）";
+        }
+    }
+    if (!injected) {
+        hooked_ = false;
+        return;
+    }
+    // 设置变了马上同步；否则每秒一次（检查包装还在不在、读当前人数）
+    const ULONGLONG now = GetTickCount64();
+    const bool changed = enabled != sentEnabled_ || cap != sentCap_;
+    if (job_.valid() || (!changed && now - lastSync_ < 1000))
+        return;
+    lastSync_ = now;
+    sentEnabled_ = enabled;
+    sentCap_ = cap;
+    std::string code = "local ENABLED, CAP = " + std::string(enabled ? "true" : "false") + ", " +
+        Number(static_cast<double>(cap)) + "\n" + kSyncLua;
+    job_ = Run(std::move(code));
+}

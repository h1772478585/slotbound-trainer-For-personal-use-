+namespace ui {
+
+namespace {
+
+void DrawCorePicker(Config& cfg, const CoreControl& core)
+{
+    const float scale = Scale();
+    const auto& list = core.Catalog();
+    if (list.empty()) {
+        ImGui::TextDisabled("正在读核心表…");
+        return;
+    }
+
+    int current = -1;
+    for (size_t i = 0; i < list.size(); ++i) {
+        if (list[i].id == cfg.coreForceId) {
+            current = static_cast<int>(i);
+            break;
+        }
+    }
+    if (current < 0) {
+        cfg.coreForceId = list[0].id;
+        current = 0;
+    }
+
+    const CoreDef& picked = list[current];
+    const std::string preview = picked.name + "（" + picked.id + " · " + picked.rarity + "）";
+    ImGui::SetNextItemWidth(320.0f * scale);
+    if (ImGui::BeginCombo("##forcecore", preview.c_str())) {
+        for (const CoreDef& d : list) {
+            const bool selected = d.id == cfg.coreForceId;
+            const std::string label = d.name + "（" + d.id + " · " + d.rarity + "）";
+            if (ImGui::Selectable(label.c_str(), selected))
+                cfg.coreForceId = d.id;
+            if (selected)
+                ImGui::SetItemDefaultFocus();
+        }
+        ImGui::EndCombo();
+    }
+}
+
+} // namespace
+
+void DrawCorePage(MenuContext& ctx)
+{
+    if (!DrawBridgeBar(ctx, "核心"))
+        return;
+    ctx.pages.shown.core = true;
+
+    CoreControl& core = ctx.pages.core;
+    ErrorText(core.Error());
+    HintText(core.Message());
+
+    SectionTitle("强制核心选择页");
+    ImGui::TextDisabled("不用等游戏给机会，直接打开核心选择界面；选完就关，不会反复弹。");
+    ImGui::BeginDisabled(core.Busy());
+    if (ImGui::Button("打开核心选择页"))
+        core.OpenPage();
+    ImGui::SameLine();
+    if (ImGui::Button("关闭页面"))
+        core.ClosePage();
+    ImGui::EndDisabled();
+    if (core.PageOpen())
+        ImGui::TextColored(kGreen, "核心选择页正在显示");
+    else
+        ImGui::TextDisabled("核心选择页：未显示");
+
+    SectionTitle("核心必出");
+    ToggleSwitch("指定核心必出", &ctx.cfg.coreGuaranteed,
+                 "下次进入核心选择时，指定核心会出现在第 1 个候选；仍要自己点选确认");
+    DrawCorePicker(ctx.cfg, core);
+
+    if (!core.Hooked()) {
+        ImGui::TextDisabled("正在连接游戏的核心模块…（进一局后再看）");
+    } else if (!ctx.cfg.enabled) {
+        ImGui::TextColored(kAmber, "总开关是关的：核心必出不生效");
+    } else if (ctx.cfg.coreGuaranteed) {
+        const CoreDef* d = core.Find(ctx.cfg.coreForceId);
+        ImGui::TextColored(kGreen, "已生效：下次核心候选第 1 张必为 %s（本次已塞入 %d 次）",
+                           d ? d->name.c_str() : ctx.cfg.coreForceId.c_str(), core.Hits());
+    } else {
+        ImGui::TextDisabled("关闭中：核心候选和原版一样（本次已塞入 %d 次）", core.Hits());
+    }
+
+    ImGui::Spacing();
+    ImGui::TextWrapped("原理：包装 src.game.cores.offer，把选中的核心放到候选第 1 位；"
+                       "强制页则直接构造 ui._coreSelect。两者独立，不改存档、不动游戏文件，"
+                       "关掉或修改器没开时都是原版行为。核心名从游戏内读取，版本不同可能读不到。");
+}
+
+} // namespace ui

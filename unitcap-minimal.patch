+
+namespace ui {
+
+namespace {
+
+void Clamp(int& v, int lo, int hi) { v = std::max(lo, std::min(hi, v)); }
+
+void PercentInput(const char* label, int& pct, int lo, int hi, const char* tip)
+{
+    ImGui::SetNextItemWidth(110.0f * Scale());
+    ImGui::InputInt(label, &pct, 10, 100);
+    Clamp(pct, lo, hi);
+    ImGui::SameLine();
+    ImGui::TextDisabled("%d%%", pct);
+    if (tip)
+        ImGui::SetItemTooltip("%s", tip);
+}
+
+} // namespace
+
+void DrawBattlePage(MenuContext& ctx)
+{
+    if (!DrawBridgeBar(ctx, "战斗"))
+        return;
+    ctx.pages.shown.battle = true;
+
+    BattleControl& battle = ctx.pages.battle;
+    Config& cfg = ctx.cfg;
+    ErrorText(battle.Error());
+    HintText(battle.Message());
+    if (!battle.Hooked())
+        ImGui::TextDisabled("正在连接战斗…（先进一局游戏）");
+
+    ImGui::BeginDisabled(battle.Busy());
+
+    SectionTitle("游戏速度");
+    ToggleSwitch("加速战斗 / 全局", &cfg.battleSpeedOn, "只改游戏收到的 dt，不改游戏文件；关掉恢复正常速度");
+    PercentInput("速度##sp", cfg.battleSpeedPct, 10, 500, "100% = 原速；500% = 5 倍");
+
+    SectionTitle("军团面板");
+    ImGui::TextDisabled("兵种：");
+    for (const char* s = "WASMHD"; *s; ++s) {
+        SameLineIfFits("兵种");
+        if (ImGui::RadioButton(SlotSymbolName(*s), cfg.addUnitSymbol.size() == 1 && cfg.addUnitSymbol[0] == *s))
+            cfg.addUnitSymbol = std::string(1, *s);
+    }
+    ImGui::SetNextItemWidth(90.0f * Scale());
+    ImGui::InputInt("数量##uc", &cfg.addUnitCount, 1, 5);
+    Clamp(cfg.addUnitCount, 1, 99);
+    ImGui::SameLine();
+    if (ImGui::Button("加入军团"))
+        battle.AddUnits(cfg.addUnitSymbol, cfg.addUnitCount);
+    ImGui::TextDisabled("走游戏自己的 battlefield:spawn，下一帧单位就会出现在队伍里");
+
+    SectionTitle("商店");
+    if (ImGui::Button("刷新商店物品"))
+        battle.RerollShop();
+    ImGui::SameLine();
+    ImGui::TextDisabled("重新抽 3 件商品，已购列表不变");
+
+    SectionTitle("成长 / 经验");
+    ToggleSwitch("全队经验倍率", &cfg.expMulOn, "游戏实际靠吸收涨级，这里放大吸收带来的属性成长");
+    PercentInput("倍率##ex", cfg.expMulPct, 100, 1000, "100% = 原版；500% = 吸收成长 ×5");
+
+    SectionTitle("生命");
+    ToggleSwitch("无限生命次数", &cfg.infiniteLives, "基地生命不减，同时挡住审判 / BOSS 波的直接判负");
+    ToggleSwitch("全队无限生命", &cfg.infiniteUnitHp, "战斗中友军血量每帧回满并免疫伤害");
+    ImGui::SetNextItemWidth(110.0f * Scale());
+    ImGui::InputInt("增加生命点数##lp", &cfg.lifePointsAdd, 1, 10);
+    Clamp(cfg.lifePointsAdd, 1, 9999);
+    ImGui::SameLine();
+    if (ImGui::Button("应用"))
+        battle.AddLifePoints(cfg.lifePointsAdd);
+
+    SectionTitle("战斗强化");
+    PercentInput("防御##df", cfg.defensePct, 0, 70, "额外减伤；游戏内部硬上限 70%");
+    ToggleSwitch("全队伤害倍率", &cfg.damageMulOn, "按缓存的原始伤害乘倍率，关掉会还原");
+    PercentInput("倍率##dm", cfg.damageMulPct, 100, 10000, "100% = 原版；1000% = 10 倍");
+    ToggleSwitch("一击必杀", &cfg.oneHitKill, "每帧把敌人血量压到 1；下一击即可击杀");
+    ToggleSwitch("自定义核心 / 商店刷新花费", &cfg.rerollCostOn,
+                 "打开后核心和商店的刷新价格都变成下面填的数；关掉恢复原版价格");
+    ImGui::SetNextItemWidth(110.0f * Scale());
+    ImGui::InputInt("刷新花费（水晶）##rc", &cfg.rerollCostValue, 1, 10);
+    Clamp(cfg.rerollCostValue, 0, 9999);
+    ImGui::SameLine();
+    ImGui::TextDisabled("0 = 免费");

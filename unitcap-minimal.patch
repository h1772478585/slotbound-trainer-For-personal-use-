+    ToggleSwitch("全队伤害倍率", &cfg.damageMulOn, "按缓存的原始伤害乘倍率，关掉会还原");
+    PercentInput("倍率##dm", cfg.damageMulPct, 100, 10000, "100% = 原版；1000% = 10 倍");

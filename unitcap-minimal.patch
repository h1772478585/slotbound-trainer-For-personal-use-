+    ImGui::EndDisabled();
+
+    ImGui::Spacing();
+    ImGui::TextWrapped("这些开关都是纯内存 Lua 包装：每局换图 / 重开游戏会自动重新挂上，"
+                       "关掉或修改器没开时走游戏原版逻辑。游戏更新后若字段名变了，页面会提示连不上。");
+}

+
+    SectionTitle("Lua 诊断（需要注入）");
+    static char code[512] = "return tostring(_G.coins)";
+    ImGui::InputTextMultiline("##luacode", code, sizeof(code), ImVec2(0.0f, 60.0f * Scale()));
+    if (ImGui::Button("执行 Lua"))
+        ctx.pages.RunDiag(code);
+    ImGui::SameLine();
+    if (ImGui::Button("诊断金币变量"))
+        ctx.pages.RunDiag(R"lua(
+local out = {}
+local function add(s) out[#out+1] = s end
+add('coins=' .. tostring(rawget(_G, 'coins')))
+add('displayCoins=' .. tostring(rawget(_G, 'displayCoins')))
+local u = rawget(_G, 'ui')
+add('ui.coinsBalanceTarget=' .. tostring(type(u) == 'table' and u.coinsBalanceTarget))
+local bf = rawget(_G, 'battlefield')
+add('battlefield.coins=' .. tostring(type(bf) == 'table' and rawget(bf, 'coins')))
+local near = {}
+for k, v in pairs(_G) do
+  if type(k) == 'string' and type(v) == 'number' then
+    near[#near+1] = { k = k, v = v, d = math.abs(v - 100) }
+  end
+end
+table.sort(near, function(a, b) return a.d < b.d end)
+local s = {}
+for i = 1, math.min(30, #near) do
+  s[#s+1] = string.format('%s=%.6g(Δ%.6g)', near[i].k, near[i].v, near[i].d)
+end
+add('最接近100的全局: ' .. table.concat(s, ', '))
+return table.concat(out, '\n')
+)lua");
+    ImGui::TextDisabled("结果：");
+    ImGui::TextWrapped("%s", ctx.pages.diagResult.empty() ? "（还没有执行）" : ctx.pages.diagResult.c_str());
 }
 

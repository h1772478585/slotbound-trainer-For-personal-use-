+    SectionTitle("生命");
+    ToggleSwitch("无限生命次数", &cfg.infiniteLives, "基地生命不减，同时挡住审判 / BOSS 波的直接判负");
+    ToggleSwitch("全队无限生命", &cfg.infiniteUnitHp, "战斗中友军血量每帧回满并免疫伤害");

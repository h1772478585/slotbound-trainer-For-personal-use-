diff --git a/src/game/unitcap.cpp b/src/game/unitcap.cpp
new file mode 100644
index 0000000..824df13
--- /dev/null
+++ b/src/game/unitcap.cpp
@@ -0,0 +1,94 @@
+#include "unitcap.h"
+
+#include <windows.h>
+
+#include <cstdlib>
+
+#include "luaops.h"
+
+namespace {
+
+using namespace luaops;
+
+// 装包装（已装就跳过）+ 写设置，回：状态  生效上限  当前人数  原版上限
+// 游戏里的公式是 5 + require('src.ui.upgrade').getMaxUnitBonus()；包装只改这个返回值。
+// 用 rawget/rawset 碰 _G，跟游戏和修改器其它 hook 的写法保持一致。
+constexpr const char* kSyncLua = R"lua(
+local function getModule()
+  for _, name in ipairs({ 'src.ui.upgrade', 'src.game.upgrade' }) do
+    local m = package.loaded[name]
+    if type(m) == 'table' and type(m.getMaxUnitBonus) == 'function' then return m end
+  end
+  local ok, m = pcall(require, 'src.ui.upgrade')
+  if ok and type(m) == 'table' and type(m.getMaxUnitBonus) == 'function' then return m end
+  return nil
+end
+local U = getModule()
+if not U then return 'no_module\t0\t-1\t0' end
+local H = rawget(_G, '__sbUnitCapHook')
+local cur = U.getMaxUnitBonus
+if type(H) ~= 'table' or H.wrapper ~= cur or H.module ~= U then
+  local orig = cur
+  H = { orig = orig, module = U }
+  H.wrapper = function(...)
+    local c = rawget(_G, '__sbUnitCapCfg')
+    if c and c.enabled then
+      local n = tonumber(c.cap)
+      if n and n >= 5 then return math.max(0, math.floor(n) - 5) end
+    end
+    return orig(...)
+  end
+  U.getMaxUnitBonus = H.wrapper
+  rawset(_G, '__sbUnitCapHook', H)
+end
+local c = rawget(_G, '__sbUnitCapCfg')
+if type(c) ~= 'table' then c = {}; rawset(_G, '__sbUnitCapCfg', c) end
+c.enabled = ENABLED
+c.cap = CAP
+local bf = rawget(_G, 'battlefield')
+local count = -1
+if type(bf) == 'table' and type(bf.getOwnedUnitCount) == 'function' then
+  local ok2, n = pcall(bf.getOwnedUnitCount, bf)
+  if ok2 then count = math.max(0, math.floor(tonumber(n) or 0)) end
+end
+local ok3, bonus = pcall(H.orig)
+if not ok3 then bonus = 0 end
+local origCap = 5 + math.max(0, math.floor(tonumber(bonus) or 0))
+local eff = c.enabled and math.max(5, math.floor(tonumber(c.cap) or 5)) or origCap
+return 'ok\t' .. tostring(eff) .. '\t' .. tostring(count) .. '\t' .. tostring(origCap)
+)lua";
+
+} // namespace
+
+void UnitCapControl::Update(bool injected, bool enabled, int cap)
+{
+    if (Ready(job_)) {
+        const bridge::Result r = job_.get();
+        if (!r.ok) {
+            error_ = r.text;
+            hooked_ = false;
+        } else {
+            const auto f = Split(r.text, '\t');
+            hooked_ = f[0] == "ok";
+            effectiveCap_ = f.size() > 1 ? atoi(f[1].c_str()) : 0;
+            unitCount_ = f.size() > 2 ? atoi(f[2].c_str()) : -1;
+            originalCap_ = f.size() > 3 ? atoi(f[3].c_str()) : 0;
+            error_ = hooked_ ? std::string() : "没找到游戏的 getMaxUnitBonus（版本不对？）";
+        }
+    }
+    if (!injected) {
+        hooked_ = false;
+        return;
+    }
+    // 设置变了马上同步；否则每秒一次（检查包装还在不在、读当前人数）
+    const ULONGLONG now = GetTickCount64();
+    const bool changed = enabled != sentEnabled_ || cap != sentCap_;
+    if (job_.valid() || (!changed && now - lastSync_ < 1000))
+        return;
+    lastSync_ = now;
+    sentEnabled_ = enabled;
+    sentCap_ = cap;
+    std::string code = "local ENABLED, CAP = " + std::string(enabled ? "true" : "false") + ", " +
+        Number(static_cast<double>(cap)) + "\n" + kSyncLua;
+    job_ = Run(std::move(code));
+}
diff --git a/src/game/unitcap.h b/src/game/unitcap.h
new file mode 100644
index 0000000..71130a7
--- /dev/null
+++ b/src/game/unitcap.h
@@ -0,0 +1,34 @@
+#pragma once
+
+#include <future>
+#include <string>
+
+#include "bridge/luaclient.h"
+
+// 人数上限（指挥上限）控制：经 Lua 桥包住游戏的 src.ui.upgrade.getMaxUnitBonus。
+//
+// 游戏源码里的上限算法是 5 + getMaxUnitBonus()，升级树的指挥 I/II/III 让它变成 6/7/8。
+// 包装后按修改器设置的「上限 N」返回 N-5，于是上限就变成 N；关掉或修改器没注入时原样透传，
+// 游戏升级树和存档都不动。每秒检查一次包装还在不在（换局、重新注入都能恢复）。
+class UnitCapControl {
+public:
+    // 每帧调用。injected = Lua 桥可用；enabled / cap 是当前设置（总开关关时 enabled 为 false）
+    void Update(bool injected, bool enabled, int cap);
+
+    bool Hooked() const { return hooked_; }             // 找到游戏函数并装好包装
+    int EffectiveCap() const { return effectiveCap_; }  // 游戏当前实际用的上限
+    int OriginalCap() const { return originalCap_; }    // 不改时的上限（5 + 升级树加成）
+    int UnitCount() const { return unitCount_; }        // 当前己方单位数；-1 = 还没读到
+    const std::string& Error() const { return error_; }
+
+private:
+    std::future<bridge::Result> job_;
+    unsigned long long lastSync_ = 0;
+    bool sentEnabled_ = false;
+    int sentCap_ = 0;
+    bool hooked_ = false;
+    int effectiveCap_ = 0;
+    int originalCap_ = 0;
+    int unitCount_ = -1;
+    std::string error_;
+};

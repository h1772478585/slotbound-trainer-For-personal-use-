diff --git a/src/ui/page_unitcap.cpp b/src/ui/page_unitcap.cpp
new file mode 100644
index 0000000..bd41d2f
--- /dev/null
+++ b/src/ui/page_unitcap.cpp
@@ -0,0 +1,56 @@
+// 「人数上限」页：把游戏的指挥上限 5 + getMaxUnitBonus() 改成想要的值
+
+#include <algorithm>
+
+#include "pages.h"
+#include "widgets.h"
+
+namespace ui {
+
+void DrawUnitCapPage(MenuContext& ctx)
+{
+    if (!DrawBridgeBar(ctx, "人数上限"))
+        return;
+    ctx.pages.shown.unitcap = true;
+
+    const UnitCapControl& cap = ctx.pages.unitCap;
+    ErrorText(cap.Error());
+
+    SectionTitle("队伍人数上限");
+    ToggleSwitch("启用人数上限", &ctx.cfg.unitCapEnabled,
+                 "打开后游戏的队伍容量会变成下面填的数；关掉立刻恢复原版上限");
+    ImGui::TextDisabled("上限人数（最小 5；填太大可能影响帧率）");
+    ImGui::SameLine();
+    ImGui::SetNextItemWidth(130.0f * Scale());
+    ImGui::InputInt("##unitcap", &ctx.cfg.unitCap, 1, 10);
+    ctx.cfg.unitCap = std::max(5, std::min(999, ctx.cfg.unitCap));
+
+    ImGui::TextDisabled("常用：");
+    static const int kPresets[] = { 5, 6, 8, 12, 20, 99, 999 };
+    for (int n : kPresets) {
+        SameLineIfFits("预设");
+        const std::string label = std::to_string(n);
+        if (ImGui::SmallButton(label.c_str()))
+            ctx.cfg.unitCap = n;
+    }
+
+    const std::string countText = cap.UnitCount() < 0 ? std::string("读不到") : std::to_string(cap.UnitCount());
+
+    if (!cap.Hooked()) {
+        ImGui::TextDisabled("正在连接游戏的上限函数…（进一局后再看）");
+    } else if (!ctx.cfg.enabled) {
+        ImGui::TextColored(kAmber, "总开关是关的：当前用的是原版上限 %d 人", cap.OriginalCap());
+    } else if (ctx.cfg.unitCapEnabled) {
+        ImGui::TextColored(kGreen, "已生效：上限 %d 人；当前 %s 人", cap.EffectiveCap(), countText.c_str());
+    } else {
+        ImGui::TextDisabled("关闭中：原版上限 %d 人；当前 %s 人", cap.OriginalCap(), countText.c_str());
+    }
+
+    ImGui::Spacing();
+    ImGui::TextWrapped("原版容量 = 5 + 升级树「指挥 I / II / III」加成（0~3，最多 8 人）。"
+                       "这里在游戏里包住 src.ui.upgrade.getMaxUnitBonus，让它返回「上限 - 5」；"
+                       "不改存档、不动升级树，关掉或修改器没开时都是原版。"
+                       "如果上限改了但画面人数没跟上，先转一次或重新进局看看。");
+}
+
+} // namespace ui

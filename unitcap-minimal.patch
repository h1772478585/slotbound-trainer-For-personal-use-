+{
+    ImGui::SetNextItemWidth(110.0f * Scale());
+    ImGui::InputInt(label, &pct, 10, 100);
+    Clamp(pct, lo, hi);
+    ImGui::SameLine();
+    ImGui::TextDisabled("%d%%", pct);

diff --git a/src/game/battlectl.cpp b/src/game/battlectl.cpp
new file mode 100644
index 0000000..a897205
--- /dev/null
+++ b/src/game/battlectl.cpp
@@ -0,0 +1,276 @@
+#include "battlectl.h"
+
+#include <windows.h>
+
+#include <string>
+
+#include "luaops.h"
+
+namespace {
+
+using namespace luaops;
+
+// 逐帧生效的开关全部塞进 _G.__sbBattleCfg，包装函数每次现查；关掉透传。
+// 回：状态  1
+constexpr const char* kSyncLua = R"lua(
+local c = rawget(_G, '__sbBattleCfg')
+if type(c) ~= 'table' then c = {}; rawset(_G, '__sbBattleCfg', c) end
+c.speed = SPEED
+c.expMul = EXPMUL
+c.infLives = INFLIVES
+c.infHp = INFHP
+c.defense = DEFENSE
+c.damage = DAMAGE
+c.oneHit = ONEHIT
+c.rerollCost = REROLLCOST -- -1 = 关闭；>=0 = 想要的花费
+
+-- 核心 / 商店刷新花费：点击前后把花费字段压成设定值
+local LP = type(love) == 'table' and love or nil
+if c.rerollCost >= 0 and LP and type(LP.mousepressed) == 'function' then
+  local MH = rawget(_G, '__sbMouseHook')
+  local cur = LP.mousepressed
+  if type(MH) ~= 'table' or MH.wrapper ~= cur then
+    local orig = cur
+    MH = { orig = orig }
+    local function cheap()
+      local u = rawget(_G, 'ui')
+      if type(u) ~= 'table' then return end
+      local cfg = rawget(_G, '__sbBattleCfg') or {}
+      local n = tonumber(cfg.rerollCost)
+      if n == nil or n < 0 then return end
+      n = math.max(0, math.floor(n))
+      u._coreSelectRerollCost = n
+      u._itemRerollCost = n
+      if type(u._coreSelect) == 'table' then
+        u._coreSelect.rerollCost = n
+        u._coreSelect._paidRerollCost = n
+      end
+    end
+    MH.wrapper = function(...)
+      cheap()
+      local r = orig(...)
+      cheap()
+      return r
+    end
+    LP.mousepressed = MH.wrapper
+    rawset(_G, '__sbMouseHook', MH)
+  end
+end
+
+-- 经验倍率：游戏成长实际是 absorbLV，包装它的成长倍率表
+local K = package.loaded['src.data.constants']
+if type(K) == 'table' and type(K.evolution) == 'table' and type(K.evolution.getAbsorbLvMultipliers) == 'function' then
+  local E = K.evolution
+  local H = rawget(_G, '__sbExpHook')
+  local cur = E.getAbsorbLvMultipliers
+  if type(H) ~= 'table' or H.wrapper ~= cur then
+    local orig = cur
+    H = { orig = orig }
+    H.wrapper = function(...)
+      local r = orig(...)
+      local cfg = rawget(_G, '__sbBattleCfg')
+      local m = cfg and tonumber(cfg.expMul) or 1
+      if type(r) == 'table' and m and m ~= 1 then
+        local v = {}
+        for k, val in pairs(r) do
+          if type(val) == 'number' and val > 1 then v[k] = 1 + (val - 1) * m else v[k] = val end
+        end
+        return v
+      end
+      return r
+    end
+    E.getAbsorbLvMultipliers = H.wrapper
+    rawset(_G, '__sbExpHook', H)
+  end
+end
+
+-- 逐帧生效：包 battlefield.update。换局重建实例时靠 BF ~= self 重新装。
+local bf = rawget(_G, 'battlefield')
+if type(bf) ~= 'table' or type(bf.update) ~= 'function' then return 'nobf\t0' end
+local BH = rawget(_G, '__sbBattleUpdateHook')
+if type(BH) ~= 'table' or BH.bf ~= bf or BH.wrapper ~= bf.update then
+  local orig = bf.update
+  BH = { orig = orig, bf = bf }
+  local function apply(self)
+    local cfg = rawget(_G, '__sbBattleCfg') or {}
+    if cfg.infLives then
+      self.baseDamageBuffer = 0
+      if (tonumber(self.baseHP) or 0) < 9999 then self.baseHP = 9999 end
+      self.suddenDeathWave = false
+      self.gameOver = false
+    end
+    for _, a in ipairs(self.allies or {}) do
+      if type(a) == 'table' then
+        if cfg.infHp then
+          a.hp = a.maxhp or a.hp
+          a.invuln = true
+          a._invulnT = 1e9
+        end
+        local dr = tonumber(cfg.defense) or 0
+        if dr > 0 and (tonumber(a.selfDR) or 0) < dr then a.selfDR = dr end
+        local mul = tonumber(cfg.damage) or 1
+        if mul ~= 1 then
+          local base = a.__sbBaseDmg
+          if type(base) ~= 'number' then base = tonumber(a.dmg) or 0; a.__sbBaseDmg = base end
+          a.dmg = base * mul
+        elseif type(a.__sbBaseDmg) == 'number' then
+          a.dmg = a.__sbBaseDmg
+          a.__sbBaseDmg = nil
+        end
+      end
+    end
+    if cfg.oneHit then
+      for _, e in ipairs(self.enemies or {}) do
+        if type(e) == 'table' then e.hp = 1 end
+      end
+    end
+  end
+  BH.wrapper = function(self, dt, ...)
+    local cfg = rawget(_G, '__sbBattleCfg') or {}
+    local speed = tonumber(cfg.speed) or 1
+    if speed ~= 1 then dt = dt * speed end
+    apply(self)
+    local r = orig(self, dt, ...)
+    apply(self) -- 游戏里有些技能会重置 invuln，orig 之后再补一次
+    return r
+  end
+  bf.update = BH.wrapper
+  rawset(_G, '__sbBattleUpdateHook', BH)
+end
+return 'ok\t1'
+)lua";
+
+constexpr const char* kAddUnitsLua = R"lua(
+local bf = rawget(_G, 'battlefield')
+if type(bf) ~= 'table' or type(bf.spawn) ~= 'function' then return 'nobf' end
+local ok, err = pcall(bf.spawn, bf, SYMBOL, COUNT)
+if not ok then return 'err:' .. tostring(err) end
+return 'ok'
+)lua";
+
+constexpr const char* kRerollShopLua = R"lua(
+local ui = rawget(_G, 'ui')
+if type(ui) ~= 'table' then return 'noui' end
+local I = package.loaded['src.game.item'] or require('src.game.item')
+if type(I) ~= 'table' or type(I.offer) ~= 'function' then return 'noitem' end
+local bf = rawget(_G, 'battlefield')
+local wave = bf and type(bf.wave) == 'table' and tonumber(bf.wave.id) or 1
+local ok, offers = pcall(I.offer, 3, wave, ui._itemPurchased or {})
+if not ok or type(offers) ~= 'table' then return 'nooffers' end
+ui._itemOffers = offers
+ui._itemShopPurchased = {}
+return 'ok'
+)lua";
+
+constexpr const char* kAddLifeLua = R"lua(
+local bf = rawget(_G, 'battlefield')
+if type(bf) ~= 'table' then return 'nobf' end
+bf.baseHP = math.max(0, (tonumber(bf.baseHP) or 0) + N)
+return 'ok'
+)lua";
+
+} // namespace
+
+void BattleControl::OnAction(const bridge::Result& r)
+{
+    if (!r.ok) {
+        error_ = "失败：" + r.text;
+        message_.clear();
+        return;
+    }
+    error_.clear();
+    if (r.text == "ok") {
+        if (pendingAction_ == "add")
+            message_ = "已把单位加入军团（下一帧生效）";
+        else if (pendingAction_ == "reroll")
+            message_ = "商店物品已刷新";
+        else
+            message_ = "生命点数已增加";
+    } else if (r.text == "nobf")
+        error_ = "失败：还没进到一局游戏里";
+    else if (r.text == "noui")
+        error_ = "失败：还没连上游戏界面";
+    else if (r.text == "noitem")
+        error_ = "失败：找不到商店模块";
+    else if (r.text == "nooffers")
+        error_ = "失败：游戏没生成商店物品";
+    else
+        error_ = "失败：" + r.text;
+}
+
+void BattleControl::Update(bool injected, bool speedOn, int speedPct, bool expOn, int expPct,
+                           bool infLives, bool infHp, int defensePct, bool damageOn, int damagePct,
+                           bool oneHit, bool rerollCostOn, int rerollCostValue)
+{
+    if (Ready(syncJob_)) {
+        const bridge::Result r = syncJob_.get();
+        if (!r.ok) {
+            error_ = r.text;
+            hooked_ = false;
+        } else {
+            const auto f = Split(r.text, '\t');
+            hooked_ = f[0] == "ok";
+            if (!hooked_)
+                error_ = "还没进到一局游戏（找不到 battlefield）";
+            else
+                error_.clear();
+        }
+    }
+    if (Ready(actionJob_))
+        OnAction(actionJob_.get());
+
+    if (!injected) {
+        hooked_ = false;
+        return;
+    }
+    const bool changed = speedOn != sentSpeedOn_ || speedPct != sentSpeedPct_ || expOn != sentExpOn_ ||
+        expPct != sentExpPct_ || infLives != sentInfLives_ || infHp != sentInfHp_ ||
+        defensePct != sentDefensePct_ || damageOn != sentDamageOn_ || damagePct != sentDamagePct_ ||
+        oneHit != sentOneHit_ || rerollCostOn != sentRerollCostOn_ || rerollCostValue != sentRerollCostValue_;
+    const ULONGLONG now = GetTickCount64();
+    if (syncJob_.valid() || (!changed && now - lastSync_ < 500))
+        return;
+    lastSync_ = now;
+    sentSpeedOn_ = speedOn; sentSpeedPct_ = speedPct;
+    sentExpOn_ = expOn; sentExpPct_ = expPct;
+    sentInfLives_ = infLives; sentInfHp_ = infHp;
+    sentDefensePct_ = defensePct;
+    sentDamageOn_ = damageOn; sentDamagePct_ = damagePct;
+    sentOneHit_ = oneHit; sentRerollCostOn_ = rerollCostOn; sentRerollCostValue_ = rerollCostValue;
+
+    const std::string prefix =
+        "local SPEED = " + Number(speedOn ? speedPct / 100.0 : 1.0) +
+        "\nlocal EXPMUL = " + Number(expOn ? expPct / 100.0 : 1.0) +
+        "\nlocal INFLIVES = " + (infLives ? "true" : "false") +
+        "\nlocal INFHP = " + (infHp ? "true" : "false") +
+        "\nlocal DEFENSE = " + Number(defensePct / 100.0) +
+        "\nlocal DAMAGE = " + Number(damageOn ? damagePct / 100.0 : 1.0) +
+        "\nlocal ONEHIT = " + (oneHit ? "true" : "false") +
+        "\nlocal REROLLCOST = " + Number(rerollCostOn ? static_cast<double>(rerollCostValue) : -1.0) + "\n";
+    syncJob_ = Run(prefix + kSyncLua);
+}
+
+void BattleControl::AddUnits(const std::string& symbol, int count)
+{
+    if (actionJob_.valid())
+        return;
+    pendingAction_ = "add";
+    const std::string prefix = "local SYMBOL, COUNT = " + Quote(symbol) + ", " + Number(count) + "\n";
+    actionJob_ = Run(prefix + kAddUnitsLua);
+}
+
+void BattleControl::RerollShop()
+{
+    if (actionJob_.valid())
+        return;
+    pendingAction_ = "reroll";
+    actionJob_ = Run(kRerollShopLua);
+}
+
+void BattleControl::AddLifePoints(int n)
+{
+    if (actionJob_.valid())
+        return;
+    pendingAction_ = "life";
+    actionJob_ = Run(std::string("local N = ") + Number(n) + "\n" + kAddLifeLua);
+}

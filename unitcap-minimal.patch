+// 「概率」页：老虎机稀有度与符号概率
+
+#include <algorithm>
+
+#include "labels.h"
+#include "pages.h"
+#include "widgets.h"
+
+namespace ui {
+
+namespace {
+
+void Pct(const char* label, double& v, double hi, const char* tip)
+{
+    ImGui::SetNextItemWidth(90.0f * Scale());
+    ImGui::InputDouble(label, &v, 0.1, 1.0, "%.2f");
+    v = std::max(0.0, std::min(hi, v));
+    if (tip)
+        ImGui::SetItemTooltip("%s", tip);
+}
+
+} // namespace
+
+void DrawOddsPage(MenuContext& ctx)
+{
+    if (!DrawBridgeBar(ctx, "概率"))
+        return;
+    ctx.pages.shown.odds = true;
+
+    OddsControl& odds = ctx.pages.odds;
+    Config& cfg = ctx.cfg;
+    ErrorText(odds.Error());
+
+    SectionTitle("稀有度概率");
+    ToggleSwitch("自定义稀有度概率", &cfg.rarityOn,
+                 "老虎机抽单位品级时按下面的比例；不用自己凑 100%，游戏里会自动归一化");
+    Pct("普通##r1", cfg.rarityNormal, 100.0, nullptr);
+    ImGui::SameLine(); Pct("高级##r2", cfg.rarityAdvanced, 100.0, nullptr);
+    Pct("稀有##r3", cfg.rarityRare, 100.0, nullptr);
+    ImGui::SameLine(); Pct("传说##r4", cfg.rarityLegendary, 100.0, nullptr);
+    Pct("棱彩##r5", cfg.rarityPrism, 100.0, nullptr);
+    ImGui::TextDisabled("稀有度代理：%s", odds.RarityProxy() ? "已挂上" : "未挂上");
+
+    SectionTitle("符号概率");
+    ToggleSwitch("自定义符号概率", &cfg.symbolOn,
+                 "六种职业符号按下面的比例；小丑单独算，先扣掉小丑概率，再把职业归一到剩下的部分");
+    Pct("战士 W##s1", cfg.symW, 100.0, nullptr);
+    ImGui::SameLine(); Pct("弓手 A##s2", cfg.symA, 100.0, nullptr);
+    Pct("枪兵 S##s3", cfg.symS, 100.0, nullptr);
+    ImGui::SameLine(); Pct("骑兵 H##s4", cfg.symH, 100.0, nullptr);
+    Pct("法师 M##s5", cfg.symM, 100.0, nullptr);
+    ImGui::SameLine(); Pct("决斗者 D##s6", cfg.symD, 100.0, nullptr);
+    Pct("小丑 %##s7", cfg.symJoker, 5.0, "游戏对小丑概率有 5% 硬上限，填超过也只按 5% 算");
+    ImGui::TextDisabled("符号代理：%s；小丑 Hook：%s",
+                        odds.SymbolProxy() ? "已挂上" : "未挂上",
+                        odds.JokerHook() ? "已挂上" : "未挂上");
+
+    ImGui::Spacing();
+    ImGui::TextWrapped("原理：在游戏里给 constants.unitGrades.probabilities / constants.slot.symbolWeights "
+                       "装元表代理，读取时返回你填的比例，写入仍交给游戏原逻辑。"
+                       "关掉开关就透传原版概率，不改游戏文件；换局 / 重开后每秒自检会重新挂上。");
+}
+
+} // namespace ui
